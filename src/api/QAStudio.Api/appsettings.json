{
  "Database": {
    "Provider": "SqlServer"
  },
  "ConnectionStrings": {
    "SqlServer": "Server=localhost;Database=QAStudioDb;Trusted_Connection=True;TrustServerCertificate=True;",
    "Postgres": "Host=localhost;Port=5432;Database=qa_studio;Username=postgres;Password=changeme"
  },
  "Jwt": {
    "Secret": "CHANGE-THIS-TO-32-CHARS-MINIMUM-SECRET-KEY",
    "Issuer": "QAStudio",
    "Audience": "QAStudio",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 7
  },
  "Playwright": {
    "BrowsersPath": "./playwright-browsers",
    "RecordTimeoutSeconds": 300,
    "StepTimeoutMs": 30000,
    "VideoEnabled": true,
    "TraceEnabled": true,
    "ScreenshotOnEveryStep": true,
    "Headless": true
  },
  "Storage": {
    "UploadsPath": "./uploads",
    "ScreenshotsPath": "./uploads/screenshots",
    "VideosPath": "./uploads/videos",
    "TracesPath": "./uploads/traces",
    "MaxUploadSizeMb": 100
  },
  "Notifications": {
    "Email": {
      "Enabled": false,
      "SmtpHost": "smtp.mailgun.org",
      "SmtpPort": 587,
      "SmtpUser": "apikey",
      "SmtpPass": "",
      "FromAddress": "qa@your-domain.com"
    },
    "Slack": {
      "Enabled": false,
      "WebhookUrl": ""
    }
  },
  "Scheduling": {
    "Provider": "Hangfire",
    "CronTimezone": "UTC"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
